+        relay: assembly.relay?.({ dataDir: join(ctx.dataDir, DESKTOP_PET_ID), secret: (name) => ctx.secret(name), cfg: ctx.cfg }) ?? undefined,
       });
       assembly.onCreate?.(world);
       return world;
